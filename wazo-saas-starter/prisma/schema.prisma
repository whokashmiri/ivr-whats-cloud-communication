generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum OrganizationRole {
  COMPANY_ADMIN
  SUPERVISOR
  AGENT
}

enum OrganizationStatus {
  PENDING
  PROVISIONING
  ACTIVE
  SUSPENDED
  REJECTED
  FAILED_PROVISIONING
}

// ==========================================
// USERS
// ==========================================

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String
  platformRole PlatformRole @default(USER)
  isActive     Boolean      @default(true)

  emailVerifiedAt DateTime?

  memberships     Membership[]
  sessions        Session[]
  invitationsSent Invitation[] @relation("InvitationSender")

  organizationsRequested Organization[] @relation("OrganizationRequester")
  organizationsReviewed  Organization[] @relation("OrganizationReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// ORGANIZATIONS
// ==========================================

model Organization {
  id   String @id @default(uuid())
  name String

  // Populated after Wazo provisioning
  wazoTenantUuid String? @unique

  status OrganizationStatus @default(PENDING)

  email   String?
  phone   String?
  country String  @default("SA")

  // Registration requester
  requestedById String?
  requestedBy   User?   @relation("OrganizationRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  // Platform administrator reviewer
  reviewedById String?
  reviewedBy   User?   @relation("OrganizationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt      DateTime?
  rejectionReason String?

  // Telephony provisioning
  provisioningStartedAt DateTime?
  provisionedAt         DateTime?
  provisioningError     String?

  memberships Membership[]
  invitations Invitation[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  waChannels WaChannel[]

  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
}

// ==========================================
// MEMBERSHIPS
// ==========================================

model Membership {
  id             String @id @default(uuid())
  userId         String
  organizationId String

  role OrganizationRole @default(AGENT)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

// ==========================================
// AUTHENTICATION SESSIONS
// ==========================================

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// INVITATIONS
// ==========================================

model Invitation {
  id             String           @id @default(uuid())
  email          String
  tokenHash      String           @unique
  organizationId String
  invitedById    String
  role           OrganizationRole
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
}

model IvrAudio {
  id           String   @id @default(uuid()) @db.Uuid
  tenantUuid   String   @db.Uuid
  name         String
  originalName String
  menuSound    String
  createdAt    DateTime @default(now())

  @@index([tenantUuid, createdAt])
}

model WaChannel {
  id              String           @id @default(cuid())
  organizationId  String
  phoneNumberId   String           @unique
  wabaId          String
  displayNumber   String?
  tokenCiphertext String           @db.Text
  tokenIv         String
  tokenTag        String
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments     WaDepartment[]
  members         WaMember[]
  conversations   WaConversation[]
  inbound         WaInbound[]

  @@index([organizationId])
}

model WaDepartment {
  id                   String    @id @default(cuid())
  channelId            String
  externalDepartmentId String // ID in Wazo; verify this against Wazo before syncing into a public product
  name                 String
  code                 String
  enabled              Boolean   @default(true)
  channel              WaChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalDepartmentId])
  @@unique([channelId, code])
}

model WaMember {
  id             String    @id @default(cuid())
  channelId      String
  wazoUserId     Int
  departmentCode String?
  phone          String
  optedIn        Boolean   @default(false)
  optInAt        DateTime?
  enabled        Boolean   @default(true)

  channel       WaChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  notifications WaNotification[]

  @@unique([channelId, wazoUserId])
  @@unique([channelId, phone])
}

model WaConversation {
  id                  String    @id @default(cuid())
  channelId           String
  customerPhone       String
  departmentCode      String?
  status              String    @default("SELECTING")
  assignedWazoUserId  Int?
  customerWindowUntil DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  channel WaChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  inbound WaInbound[]

  @@unique([channelId, customerPhone])
}

model WaInbound {
  id                String           @id @default(cuid())
  channelId         String
  conversationId    String?
  providerMessageId String
  senderPhone       String
  messageText       String?          @db.Text
  payload           Json
  status            String           @default("PENDING")
  attempts          Int              @default(0)
  lockedAt          DateTime?
  nextAttemptAt     DateTime         @default(now())
  error             String?          @db.Text
  createdAt         DateTime         @default(now())
  channel           WaChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation      WaConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  notifications     WaNotification[]

  @@unique([channelId, providerMessageId])
  @@index([status, nextAttemptAt])
}

model WaNotification {
  id         String    @id @default(cuid())
  inboundId  String
  memberId   String
  status     String    @default("PENDING")
  providerId String?
  error      String?   @db.Text
  inbound    WaInbound @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  member     WaMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([inboundId, memberId])
}
